{
  "name": "buron",
  "version": "0.2.0",
  "description": "CLI for Buron — connect your codebase, generate marketing assets when you ship",
  "type": "module",
  "bin": {
    "buron": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run build"
  },
  "keywords": [
    "buron",
    "cli",
    "marketing",
    "changelog",
    "developer-tools"
  ],
  "license": "MIT",
  "homepage": "https://buron.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/buron-ai/buron-cli.git"
  },
  "bugs": {
    "url": "https://github.com/buron-ai/buron-cli/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.5.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "open": "^10.1.2",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/node": "^22.8.6",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3"
  }
}
